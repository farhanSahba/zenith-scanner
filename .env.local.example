# ===== مزوّد الداتا =====
# sim    = محاكاة سوق واقعية مدمجة (الافتراضي، تشتغل بدون أي حساب أو إنترنت)
# alpaca = داتا حقيقية من Alpaca (تحتاج مفاتيح)
DATA_PROVIDER=sim

# مفاتيح Alpaca (فعّلها فقط عند DATA_PROVIDER=alpaca)
# أنشئها من: https://app.alpaca.markets  →  Paper/Live  →  API Keys
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# iex = مجاني (بورصة واحدة) | sip = مدفوع (كل البورصات، يلزم باقة Algo Trader Plus)
ALPACA_FEED=iex

# الجلسة الليلية (8م–4ص بتوقيت نيويورك) على اتصال منفصل:
# off = معطّلة | overnight = مؤجّلة (باقة مجانية) | boats = لحظية (يتطلب Algo Trader Plus)
ALPACA_OVERNIGHT_FEED=off

# ===== قائمة الرموز =====
# قائمة أولية (تُحدّث يدوياً بـ scripts/build-watchlist.mjs، أو تلقائياً بالفرز أدناه)
ALPACA_SYMBOLS=AAPL,TSLA,NVDA,AMD,SOFI

# ===== الفلوت (بالملايين) — Alpaca لا توفّره =====
# ALPACA_FLOATS=TSLA:3180,RIVN:900,SOFI:1080
# الفلوت الموثوق: مفتاح Alpha Vantage المدفوع (الماسح يجلبه تلقائياً).
# رقّ الباقة: https://www.alphavantage.co/premium/  (بدونه يحاول Yahoo المجاني غير المستقر)
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=

# ===== الفرز التلقائي الحي (بلا إعادة تشغيل) =====
# on = يعيد فرز السوق دورياً ويضيف المرشّحين الجدد للبثّ تلقائياً | off = تعطيل
ALPACA_AUTOSCREEN=on
AUTOSCREEN_MAX_PRICE=20   # أقصى سعر للمرشّح
AUTOSCREEN_TOP=50         # عدد المرشّحين لكل فرز
AUTOSCREEN_MS=300000      # الفاصل بين الفرزات (ms) — 5 دقائق

# ===== طبقة الذكاء العربية (Claude) =====
# اختيارية: إذا تُركت فارغة يعمل النظام بمحلّل قواعدي عربي بديل بدون أي تكلفة.
# أنشئ المفتاح من: https://console.anthropic.com
ANTHROPIC_API_KEY=
# النموذج المستخدم للتحليل. الافتراضي الأقوى؛ للسرعة بدّله لـ claude-haiku-5-5.
AI_MODEL=claude-opus-5-5

# ===== تنبيهات الجوال (Telegram) — اختيارية =====
# ترسل التنبيهات المهمّة (لحظة الدخول + تحذير التخفيف) لجوالك.
# 1) في Telegram افتح @BotFather → /newbot → خذ التوكن.
# 2) افتح بوتك واضغط Start وأرسل أي كلمة.
# 3) ضع التوكن أدناه وأعد التشغيل، ثم افتح /api/telegram/test لاكتشاف chat_id وإرسال رسالة تجربة.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== تتبّع أداء التنبيهات =====
ALERT_HORIZON_MIN=15   # نافذة قياس نتيجة التنبيه (دقائق)
ALERT_WIN_PCT=2        # الحركة المواتية التي تعتبر التنبيه ناجحاً (%)

# ===== السوق السعودي (SAHMK · تداول) — المرحلة 3 (Pro) =====
# sim = محاكاة سعودية | sahmk = داتا تداول الحقيقية
SA_DATA_PROVIDER=sim
# المفتاح من: https://www.sahmk.sa/en/developers
# Pro: لقطات لحظية (is_delayed=false) عبر /quotes دفعة + تاريخي 1min + أساسيات، بلا حدّ طلبات يومي
SAHMK_API_KEY=
SA_INDEX=TASI          # TASI (الرئيسي) أو NOMU (الموازي)
SAHMK_POLL_MS=4000     # فاصل استطلاع /quotes (ms) — Pro يتحمّل 2–4ث؛ ارفعه للخطط الأدنى
# الفلوت بالملايين (يدوي، يتجاوز الجلب التلقائي): 2222:242000,1120:2500
SA_FLOATS=
# جلب الفلوت تلقائياً من fundamentals — on افتراضياً على Pro (off للخطط ذات الحصّة المحدودة)
SA_FETCH_FLOAT=on

# ===== حماية بكلمة مرور (للرفع على خادم عام) =====
# تحمي كل الصفحات بكلمة مرور واحدة (Basic Auth) — لمنع استنزاف مفاتيحك المدفوعة.
# اتركها فارغة محلياً (الحماية معطّلة). عند الرفع: ضع كلمة مرور قوية + استخدم HTTPS.
APP_USER=zenith
APP_PASSWORD=
